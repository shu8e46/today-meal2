<UserControl x:Class="TodayMeal.SchoolSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 학교 이름 검색. 처음 켰을 때의 화면과 설정 탭 양쪽에서 쓴다. -->
  <StackPanel>
    <Grid>
      <TextBox x:Name="Query" Style="{StaticResource LineBox}" Tag="학교 이름" FontSize="17" Height="44"
               Padding="0,0,52,0" TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"/>
      <Button x:Name="Go" Content="검색" Style="{StaticResource LinkButton}" FontSize="14"
              HorizontalAlignment="Right" VerticalAlignment="Center" Click="Go_Click"/>
    </Grid>
    <TextBlock x:Name="Status" Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource TextFaint}"
               TextWrapping="Wrap" Visibility="Collapsed"/>
    <ScrollViewer x:Name="Scroll" MaxHeight="280" Margin="0,4,0,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Results"/>
    </ScrollViewer>
  </StackPanel>
</UserControl>
