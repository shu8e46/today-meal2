<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 다크 테마. 강조색 #34C796 하나에 무채색 계열. -->
  <SolidColorBrush x:Key="Bg" Color="#141413"/>
  <SolidColorBrush x:Key="Surface" Color="#1F1F1D"/>
  <SolidColorBrush x:Key="Hover" Color="#2E2E2B"/>
  <!-- 강조색을 옅게 깔아 쓰는 곳 (선택된 칸, 급식 있는 날). #34C796 의 16% -->
  <SolidColorBrush x:Key="AccentSoft" Color="#2934C796"/>
  <SolidColorBrush x:Key="Line" Color="#2E2E2B"/>
  <SolidColorBrush x:Key="TextFaint" Color="#7A7A76"/>
  <SolidColorBrush x:Key="TextMid" Color="#A8A8A4"/>
  <SolidColorBrush x:Key="Text" Color="#EDEDEA"/>
  <SolidColorBrush x:Key="Accent" Color="#34C796"/>
  <SolidColorBrush x:Key="OnAccent" Color="#07140F"/>
</ResourceDictionary>
