<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 화이트 테마. 강조색 #0A7B55 하나에 무채색 계열. -->
  <SolidColorBrush x:Key="Bg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Surface" Color="#F5F5F2"/>
  <SolidColorBrush x:Key="Hover" Color="#E6E6E3"/>
  <!-- 강조색을 옅게 깔아 쓰는 곳 (선택된 칸, 급식 있는 날). #0A7B55 의 12% -->
  <SolidColorBrush x:Key="AccentSoft" Color="#1F0A7B55"/>
  <SolidColorBrush x:Key="Line" Color="#E6E6E3"/>
  <SolidColorBrush x:Key="TextFaint" Color="#A6A6A6"/>
  <SolidColorBrush x:Key="TextMid" Color="#6B6B6B"/>
  <SolidColorBrush x:Key="Text" Color="#141414"/>
  <SolidColorBrush x:Key="Accent" Color="#0A7B55"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
</ResourceDictionary>
